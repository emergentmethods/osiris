# ═══════════════════════════════════════════════════════════════════════════
#  OSIRIS — Environment Template
#  Copy this file to `.env` (or `.env.local`) and fill in values as needed.
#
#  IMPORTANT — read before filling anything in:
#  OSIRIS works fully WITHOUT any third-party API keys. Aviation, maritime,
#  satellites, fires, earthquakes, weather, news, CVEs, etc. all use public
#  keyless feeds (adsb.lol, celestrak.org, NASA FIRMS open CSV, USGS, …).
#
#  Optional integrations read the keys documented below, including SCANNER_URL,
#  SCANNER_KEY and ASKNEWS_API_KEY. AskNews also reads ASKNEWS_API_BASE_URL and
#  ASKNEWS_MCP_URL for trusted test/self-host endpoint overrides. See README.md
#  for setup, defaults and usage costs.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
#  RECON SCANNER BACKEND
#  Powers the RECON toolkit (quick/ssl/headers/rdns/subdomains/tech/whois/
#  geoloc/vuln scans). Requires running the separate OSIRIS scanner backend.
#  SCANNER_KEY here MUST equal the backend's OSIRIS_KEY. Generate one with:
#      openssl rand -hex 32
#  Leave both empty to simply disable the RECON features (UI returns 503).
# ─────────────────────────────────────────────────────────────────────────
SCANNER_URL=
SCANNER_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  SHODAN  ── optional; read by the code ──
#  Powers the full RECON → PORT SCAN: every open port with its service,
#  product, version, banner and CVEs (https://api.shodan.io/shodan/host/{ip}).
#  Get it: https://account.shodan.io/  (any account; host lookups use no
#  scan credits). Leave empty and PORT SCAN falls back to the keyless Shodan
#  InternetDB record — open ports, CPEs and CVEs, but no banners.
# ─────────────────────────────────────────────────────────────────────────
SHODAN_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  CLOUDFLARE RADAR  ── read by the code; enables two map layers ──
#  Powers the "Internet Outages" and "Attack Origins" layers under
#  NET & EVENT INTEL (https://radar.cloudflare.com/).
#  Free: any Cloudflare account → My Profile → API Tokens → Create Token →
#  Custom token with permission "Account · Radar · Read".
#  Leave empty to disable — /api/cloudflare-radar returns 503 and both layer
#  toggles stay hidden in the UI. The GDELT Events layer is unaffected and
#  needs no key.
# ─────────────────────────────────────────────────────────────────────────
CLOUDFLARE_API_TOKEN=


# ─────────────────────────────────────────────────────────────────────────
#  CHAIN INTEL  ── optional; the RECON "CHAIN INTEL" tab works without these ──
#  Baseline wallet forensics (BTC/ETH/SOL balance, transaction history,
#  counterparties, OFAC SDN screening, risk scoring) is fully keyless via
#  mempool.space, Blockscout and the public Solana RPC.
#
#  These only deepen it; /api/osint/crypto?probe=1 reports which are active:
#    ETHERSCAN_API_KEY  https://etherscan.io/apis  — internal txs, richer ETH
#    HELIUS_API_KEY     https://helius.dev         — parsed Solana transfers.
#                       Without it, SOL transfer amounts and counterparties
#                       stay blank: the public RPC lists signatures only.
# ─────────────────────────────────────────────────────────────────────────
ETHERSCAN_API_KEY=
HELIUS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  OPTIONAL DATA-SOURCE KEYS  (not read by current code — future / upgrades)
# ─────────────────────────────────────────────────────────────────────────

# NASA FIRMS — active wildfire hotspots.
# Free, instant. Enter an email at the page below and the MAP_KEY is emailed
# to you (looks like 'abcdef1234567890abcdef1234567890'). Limit: 5000 req /
# 10 min. The app already uses the keyless FIRMS CSV; a key only matters if
# you switch to the per-area FIRMS API.
#   Get it: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_API_KEY=

# OpenSky Network — aviation (higher rate limits than the keyless feed).
# Free account. Since March 2025 OpenSky uses OAuth2 (username/password auth
# is dropped). Create an account, open the Account page, create a new API
# client, and copy the client_id / client_secret.
#   Get it: https://opensky-network.org/  (Account → API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# N2YO — satellite tracking / pass predictions.
# Free. Register, then Profile page → scroll down → "generate API key".
# The key cannot be changed once issued. Limit: 1000 req / hour.
#   Get it: https://www.n2yo.com/login/register/  (then Profile)
N2YO_API_KEY=

# aisstream.io — live maritime AIS vessel positions via WebSocket.
# Free. Register, then create a key on the API Keys page. Used in the
# subscription message to wss://stream.aisstream.io/v0/stream.
#   Get it: https://aisstream.io/  (sign up → API Keys)
AIS_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
#  AI, INGEST AND BACKENDS
# ─────────────────────────────────────────────────────────────────────────
# These are read by the code but were missing from this file, so a deployment
# could not tell which of them gate what. The two secrets fail closed: with
# them unset their endpoints answer 503 rather than running unauthenticated.

# Google Gemini, for /api/ai/analyze, /api/ai/briefing and /api/ai/overview.
# Numbered from 1; several may be set and are rotated between. With none set
# the AI endpoints answer 503, or fall back to the heuristic analyst, and a
# reader can still supply their own key from the settings panel.
# GEMINI_API_KEY_1=

# Shared secret for POST /api/sdk/ingest. Unset, the endpoint is disabled.
# SDK_INGEST_KEY=

# GitHub webhook HMAC secret and the URL verified payloads are forwarded to.
# Unset, /api/github-webhook is disabled. Both are required together.
# GITHUB_WEBHOOK_SECRET=
# GITHUB_WEBHOOK_FORWARD_URL=

# Entity resolution backend for /api/entity/expand.
# INTEL_URL=

# Umami analytics site id; analytics are simply absent when unset.
# UMAMI_WEBSITE_ID=

# ─────────────────────────────────────────────────────────────────────────
#  RUNTIME
# ─────────────────────────────────────────────────────────────────────────
# Host port the web UI is published on (container always listens on 3000).
# Change this if 3000 is already taken on your host.
OSIRIS_PORT=3000

# Comma-separated list of public Telegram channel usernames (no @) to scrape
# for the "Telegram OSINT" map layer. Overrides the curated default set.
# Channels must have web preview enabled (most well-known OSINT channels do).
# Default if unset:
#   osintdefender,insiderpaper,aljazeeraenglish,nexta_live,war_monitor
# OSIRIS_TELEGRAM_CHANNELS=

# ─────────────────────────────────────────────────────────────────────────
#  LIVE TRANSIT — optional, free keys for more cities
# ─────────────────────────────────────────────────────────────────────────
# The Live Buses & Transit layer works with no keys: 185 operator feeds in
# 22 countries, including all of Great Britain and New York City. Each key
# below adds an operator that only publishes behind a free sign-up. A key is
# read by the server only and never sent to the browser.
# TRANSIT_WMATA_KEY=        # Washington DC Metrobus + Metrorail — https://developer.wmata.com/
# TRANSIT_511_KEY=          # San Francisco Bay Area, all operators — https://511.org/open-data/token
# TRANSIT_TRIMET_KEY=       # Portland TriMet — https://developer.trimet.org/appid/registration/
# TRANSIT_TRANSLINK_KEY=    # Vancouver TransLink — https://developer.translink.ca/
# TRANSIT_STM_KEY=          # Montréal STM — https://portail.developpeurs.stm.info/
# TRANSIT_NTA_KEY=          # All of Ireland — https://developer.nationaltransport.ie/
# TRANSIT_TRAFIKLAB_KEY=    # Stockholm SL (GTFS Regional) — https://developer.trafiklab.se/
# TRANSIT_TFNSW_KEY=        # Sydney buses, trains, metro, ferries, light rail — https://opendata.transport.nsw.gov.au/
# TRANSIT_METLINK_KEY=      # Wellington Metlink — https://opendata.metlink.org.nz/
# TRANSIT_AT_KEY=           # Auckland Transport — https://dev-portal.at.govt.nz/

# Set by the Docker image already — override only if needed.
# NODE_ENV=production
# PORT=3000
# HOSTNAME=0.0.0.0

# Optional AskNews fallback for feed, dossier, Assist, Forecast and /api/mcp.
# X-AskNews-Key takes precedence. Leave unset to require readers' own keys.
# On a public instance any visitor can spend the operator's credits through
# model-chosen calls. Restrict access before enabling this fallback.
ASKNEWS_API_KEY=
# Feed defaults: pub_date, last 30 minutes, podcasts included, no category filter.
# One search per five-minute poll per reader.
# Integers only. Invalid values use the defaults.
ASKNEWS_FEED_WINDOW_SECONDS=1800
ASKNEWS_FEED_PAGE_RANK=200000
ASKNEWS_FEED_SIZE=100
# Stories: the last 24 hours, up to 100 in pages of 10, five articles each.
# Up to ten story calls per ten-minute poll per reader.
ASKNEWS_STORIES_WINDOW_SECONDS=86400
ASKNEWS_STORIES_SIZE=100
ASKNEWS_STORIES_ARTICLES=5
# Test/self-host overrides. Trusted endpoints only; receive the selected credential.
# ASKNEWS_API_BASE_URL=https://api.asknews.app
# ASKNEWS_MCP_URL=https://mcp.asknews.app/
